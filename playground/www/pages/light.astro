---
import '~/smooth-wrapper/style.css'
import Layout from '../layouts/Layout.astro'
---

<Layout title="Lenis Light">
  <div id="smooth-wrapper">
    <div id="smooth-content">
      <!-- ALL YOUR CONTENT HERE -->
      <div id="progress"></div>
      <section id="s1">1</section>
      <section id="s2">
        <div class="sticky">sticky</div>
        2
        <div class="sync-row">
          <div id="sync-lenis" class="sync-box">lenis.on('scroll')<br />same frame</div>
          <div id="sync-dom" class="sync-box">wrapper 'scroll' event<br />one frame late</div>
        </div>
      </section>
      <section id="s3">3 <input placeholder="focus me" /></section>
      <section id="s4">
        4
        <iframe
          id="iframe-short"
          srcdoc="<p style=font:2rem/1.5,system-ui>short iframe: wheel here should scroll the page</p>"
          style="border: 4px solid #0af"></iframe>
        <iframe
          id="iframe-tall"
          srcdoc="<div style=height:3000px;background:linear-gradient(#0af,#f0a)><p style=font:2rem/1.5,system-ui>tall iframe: scrolls itself first, then chains to the page</p></div>"
          style="border: 4px solid #f0a"></iframe>
      </section>
      <section id="s5">5</section>
      <section id="s6">6</section>
      <div class="fixed">fixed (inside)</div>
    </div>
  </div>
  <!-- position: fixed elements can go outside -->
  <!-- #canvas: fixed above the wrapper, like a WebGL canvas. Ghosts sit at
       content coordinates inside it and are offset by -scroll -->
  <div id="canvas">
    <div id="ghost-lenis" class="ghost"></div>
    <div id="ghost-dom" class="ghost"></div>
  </div>
  <div id="progress-root"></div>
  <a id="anchor" href="#s6">#s6</a>
  <div id="readout" style="position: fixed; bottom: 1rem; left: 1rem; font: 1rem monospace; background: #fff"></div>
  <script src="../../light/test.ts"></script>
</Layout>

<style>
  .sync-row {
    display: flex;
    gap: 2rem;
    margin-top: 2rem;
  }

  .sync-box {
    width: 160px;
    height: 160px;
    display: grid;
    place-items: center;
    font: 0.8rem/1.4 monospace;
    color: #fff;
    text-align: center;
  }

  #sync-lenis {
    background: #0a0;
  }

  #sync-dom {
    background: #06c;
  }

  #canvas {
    position: fixed;
    inset: 0;
    pointer-events: none;
  }

  /* anchored at the canvas origin; size and position come from the cached rect */
  .ghost {
    position: absolute;
    top: 0;
    left: 0;
    box-sizing: border-box;
    border: 4px solid red;
    will-change: transform;
  }
</style>
